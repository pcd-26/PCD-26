{
    "conventionalCommits.scopes": [
        "assignment-1",
        "assignment-4",
        "assignment-2",
        "assignment-3"
    ],
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.autoClean.run": "never",
    "latex-workshop.latex.recipe.default": "make report",
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux",
        "*.log",
        "*.out",
        "*.toc"
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "make report",
            "tools": [
                "make-report"
            ]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "make-report",
            "command": "python",
            "args": [
                "C:/Users/alexs/Documents/GitHub/PCD-26/scripts/build_latex_report.py",
                "%DIR%"
            ]
        }
    ],
    "java.import.exclusions": [
        "**/verification/jpf/.jpf-core"
    ],
    "java.project.resourceFilters": [
        "node_modules",
        ".git",
        ".jpf-core"
    ],
    "files.exclude": {
        "**/verification/jpf/.jpf-core": true
    },
    "files.watcherExclude": {
        "**/target/**": true,
        "**/verification/jpf/.jpf-core/**": true
    }
}
